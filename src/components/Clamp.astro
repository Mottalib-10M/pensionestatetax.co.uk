---
/**
 * Folded standfirst (RECETTE §26, 2026-10-02): ONE <p> in the HTML, whole; the screen shows the first
 * whole sentences and the rest sits in a hidden <span> of the same <p>, unfolded by a checkbox, with
 * no JavaScript. Never cut mid-sentence, never a <details>: check-seo must find the 120-word block in
 * the first 30% of the page (§21).
 */
import { t } from '../i18n/ui';
interface Props { text: string; id: string; sentences?: number; class?: string }
const { text, id, sentences = 1, class: cls = '' } = Astro.props;
// Cut between sentences: final punctuation, space, then a capital letter. “£751.” stays whole.
const parts = text.split(/(?<=[.!?])\s+(?=\p{Lu})/u);
const head = parts.slice(0, sentences).join(' ').trim();
const rest = parts.slice(sentences).join(' ').trim();
---
<div class={`clamp ${cls}`}>
  {rest && <input type="checkbox" id={id} class="clamp-toggle" />}
  <p class="text-navy-800">{head}{rest && <span class="clamp-rest"> {rest}</span>}</p>
  {rest && <label for={id} class="clamp-more">{t('en').readMore}</label>}
</div>
