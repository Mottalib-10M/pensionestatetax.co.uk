---
/**
 * Renders a page of `src/content/pages/`. Order (RECETTE §5, §9.3, §21): H1 and standfirst, the folded
 * citable block, the tool (first screen on a tool page), then the body. A reading page (no main tool)
 * shows its date at the top right; FAQ, related pages, sources and the author box come from PageLayout,
 * the FAQ shown and marked up from the same list (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, ROUTES } from '../i18n/routes';
import { label, groupLabel } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef, ToolDef } from '../lib/guide-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const h = helpers(true);
const faqs = page.faqs(h);
const parts = page.body(h).split(/<!--tool:([a-z0-9:-]+)(?:\|(\{.*?\}))?-->/);
const jsonLd = [articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: page.h1, description: page.description, path, lang }));
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.card ?? (id === 'home' ? 'Inheritance tax on an estate with its pension, before and from 6 April 2027, and what each heir keeps.' : '') }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label.en, url: P.sources[k].url }));
const chunks: Array<{ html?: string; tool?: ToolDef }> = [];
for (let i = 0; i < parts.length; i += 3) { chunks.push({ html: parts[i] }); if (parts[i + 1]) chunks.push({ tool: { kind: parts[i + 1], props: parts[i + 2] ? JSON.parse(parts[i + 2]) : undefined } }); }
// Every page opens on a calculator within its first 250 words (tool or mini): no date above it (§8.4).
const reading = false;
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: page.nav }]} dateEnHaut={reading}>
  <article>
    <header class="mb-3">
      <p class="kicker">{groupLabel(page.group)}</p>
      <h1 class="mt-1 text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{page.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{page.intro}</p>
    </header>
    {/* Tool page: the calculator comes straight after the title so its first field sits on the first
         screen (check-premier-ecran); the citable block follows it. Reading page: block first. */}
    {!page.tool && <Clamp text={page.resume(h)} id={`clamp-${page.id}`} class="mb-3" />}
    {page.tool && <div data-outil class="mb-4"><Tool tool={page.tool} primary={true} /></div>}
    {page.tool && <Clamp text={page.resume(h)} id={`clamp-${page.id}`} class="mb-3" />}
    {page.mini && <div class="mb-4"><Tool tool={page.mini} idPrefix="g" /></div>}
    <p class="mb-8 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    <div class="prose prose-slate max-w-none">
      {chunks.map((c, i) => c.html !== undefined ? <Fragment set:html={c.html} /> : <div class="not-prose"><Tool tool={c.tool!} idPrefix={`s${i}`} /></div>)}
    </div>
  </article>
</PageLayout>
