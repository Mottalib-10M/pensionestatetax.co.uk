---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/pension-inheritance-tax-calculator/" title="Pension inheritance tax calculator 2027" width="100%" height="1100" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the pension inheritance tax calculator 2027 on your site" description="Show the pension inheritance tax calculator on your own site for free: one iframe, the Finance Act 2026 rules from April 2027, the heirs' income tax, no sign-up and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the pension inheritance tax calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a probate practice's guide, a pension forum, an advice centre or a personal finance article: visitors enter a home, savings and a pension and see the inheritance tax before and from April 2027, and what each heir keeps after income tax.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible and use it as it is, without warranty. When the rules change, the embedded calculator updates itself.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/pension-inheritance-tax-calculator/" title="Pension inheritance tax calculator 2027" width="100%" height="1100" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
